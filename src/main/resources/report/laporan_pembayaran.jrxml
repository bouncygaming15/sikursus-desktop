				<textFieldExpression><![CDATA[$F{metode}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="505" y="0" width="50" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
