<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pembayaran" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="P_TANGGAL_AWAL" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-11-01")]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TANGGAL_AKHIR" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-11-30")]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT pb.id_pembayaran, pb.tanggal_bayar, pb.nominal, pb.metode,
       pb.status AS status_pembayaran, p.id_pendaftaran,
       ps.nim, ps.nama AS nama_peserta, kls.nama_kelas, krs.nama_kursus
FROM pembayaran pb
INNER JOIN pendaftaran p ON pb.id_pendaftaran = p.id_pendaftaran
INNER JOIN peserta ps ON p.id_peserta = ps.id_peserta
INNER JOIN kelas kls ON p.id_kelas = kls.id_kelas
INNER JOIN kursus krs ON kls.id_kursus = krs.id_kursus
WHERE pb.tanggal_bayar BETWEEN $P{P_TANGGAL_AWAL} AND $P{P_TANGGAL_AKHIR}
ORDER BY pb.tanggal_bayar, pb.id_pembayaran]]>
	</queryString>
	<field name="id_pembayaran" class="java.lang.Integer"/>
	<field name="tanggal_bayar" class="java.sql.Date"/>
	<field name="nominal" class="java.math.BigDecimal"/>
	<field name="metode" class="java.lang.String"/>
	<field name="status_pembayaran" class="java.lang.String"/>
	<field name="id_pendaftaran" class="java.lang.Integer"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_peserta" class="java.lang.String"/>
	<field name="nama_kelas" class="java.lang.String"/>
	<field name="nama_kursus" class="java.lang.String"/>
	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="5" width="555" height="25"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>
				<text><![CDATA[LAPORAN PEMBAYARAN KURSUS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="32" width="555" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10"/>
				</textElement>
				<text><![CDATA[SIKURSUS Desktop - Pemrograman Berorientasi Objek]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="46" width="555" height="14"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Periode: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_TANGGAL_AWAL}) + " s/d " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{P_TANGGAL_AKHIR})]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="59" width="555" height="1"/>
			</line>
		</band>
	</title>
	<columnHeader>
		<band height="25">
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="0" y="0" width="30" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[ID]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="30" y="0" width="55" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Tanggal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="85" y="0" width="55" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[NIM]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="140" y="0" width="90" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Peserta]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="230" y="0" width="50" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Kelas]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="280" y="0" width="110" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Kursus]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="390" y="0" width="70" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Nominal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="460" y="0" width="45" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Metode]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="505" y="0" width="50" height="25"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="30" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{id_pembayaran}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement stretchType="RelativeToTallestObject" x="30" y="0" width="55" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{tanggal_bayar}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="85" y="0" width="55" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement stretchType="RelativeToTallestObject" x="140" y="0" width="90" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_peserta}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="230" y="0" width="50" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_kelas}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement stretchType="RelativeToTallestObject" x="280" y="0" width="110" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nama_kursus}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement stretchType="RelativeToTallestObject" x="390" y="0" width="70" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nominal}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement stretchType="RelativeToTallestObject" x="460" y="0" width="45" height="22"/>
				<box leftPadding="3" rightPadding="3"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
